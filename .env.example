# Copy to .env (git-ignored). Bun loads it automatically.

# Contact address appended to the User-Agent sent to every registry. Recommended by
# crates.io's crawler policy; leave empty to send only the project URL.
PKG_TRUST_CONTACT=

# Google Cloud project that runs deps.dev BigQuery queries (npm and Maven name lists for the random
# draw, and `cli registry`). Authenticate with `gcloud auth login`. See docs/development.md, BigQuery.
PKG_TRUST_GCP_PROJECT=
# Bytes one BigQuery query may bill, in GiB (default 100; the sandbox grants 1 TiB a month).
# PKG_TRUST_BQ_MAX_GIB=100
